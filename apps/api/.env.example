# Copy to .env for local development. Never commit .env itself (already gitignored).
# For unit/integration tests, no .env is needed — every test harness starts
# and configures its own disposable infrastructure (embedded PostgreSQL, a
# local JWKS server for token-verification tests).
#
# INFRA-W1D: apps/api's runtime process reads DATABASE_URL only — the same
# variable name every package's own createPostgresClient() already reads
# directly (this file adds no new naming convention). It must be the
# samvardiq_app-scoped connection string, never the migration/admin one.
# apps/api never reads MIGRATION_DATABASE_URL at all (see runtimeDbIdentity.ts,
# which only ever compares it, to catch an operator pasting the wrong value
# into DATABASE_URL — it is not consumed as a credential anywhere in this app).
DATABASE_URL=postgres://samvardiq_app:CHANGE_ME@localhost:5432/samvardiq

# Supabase project URL only — NOT a secret (the JWKS endpoint it points at is
# public by design; no service-role or anon key is read by this app at all).
SUPABASE_PROJECT_URL=https://your-project-ref.supabase.co

# Network binding, CORS and rate limiting (see src/config.ts) — all optional,
# safe defaults apply if unset. ALLOWED_ORIGINS must never be "*".
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
ALLOWED_ORIGINS=
TRUST_PROXY=false
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# WhatsApp webhook verification (CLINIC-W2B) — unrelated to database identity,
# listed here only because index.ts already reads it. Never a real value in
# staging under this workstream's scope (INFRA-W1D excludes Meta/WhatsApp
# configuration).
META_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
