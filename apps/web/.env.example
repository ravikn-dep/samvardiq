# IDENTITY-W8 — required environment variables for apps/web.
# Copy to .env.local for local development. Never commit real values.
#
# VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY: from the Supabase
# project's API settings. The publishable (anon) key is safe to ship in a
# browser bundle by Supabase's own design — it is NOT a secret and is not
# treated as one. The service-role key must NEVER appear here or anywhere
# in this package.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Base URL of the Fastify API (apps/api). No trailing slash.
VITE_SAMVARDIQ_API_URL=http://localhost:3000
