{
  "name": "@samvardiq/platform-credentials",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Provider-neutral external-provider connections and their envelope-encrypted credentials (ARCH-020, ADR-PLATFORM-001). AES-256-GCM from node:crypto; per-credential data keys wrapped by a versioned master-key ring held outside the database. Knows no provider API.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build:deps": "npm run build --prefix ../identity-access",
    "pretypecheck": "npm run build:deps",
    "typecheck": "tsc -p tsconfig.json",
    "prebuild": "npm run build:deps",
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run build:deps",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "test:integration": "node --import tsx --test --test-concurrency=1 \"test/integration/**/*.test.ts\"",
    "lint": "eslint src test",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@samvardiq/identity-access": "file:../identity-access",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0"
  }
}
