# Copy to .env for local development. Never commit .env itself (already gitignored).
# Points the Postgres adapter and drizzle-kit at a PostgreSQL instance.
# For DATA-W3 integration tests, no .env is needed at all — the test harness
# starts and configures a disposable embedded PostgreSQL instance itself.
DATABASE_URL=postgres://samvardiq_app:CHANGE_ME@localhost:5432/samvardiq
