      "checkConstraints": {
        "platform_jobs_status_check": {
          "name": "platform_jobs_status_check",
          "value": "\"platform_jobs\".\"status\" IN ('PENDING','RUNNING','RETRY_WAIT','SUCCEEDED','DEAD')"
        },
        "platform_jobs_type_check": {
          "name": "platform_jobs_type_check",
          "value": "\"platform_jobs\".\"job_type\" ~ '^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$' AND char_length(\"platform_jobs\".\"job_type\") <= 64"
        },
        "platform_jobs_key_check": {
          "name": "platform_jobs_key_check",
          "value": "char_length(\"platform_jobs\".\"idempotency_key\") BETWEEN 1 AND 200"
        },
        "platform_jobs_payload_check": {
          "name": "platform_jobs_payload_check",
          "value": "jsonb_typeof(\"platform_jobs\".\"payload\") = 'object' AND octet_length(\"platform_jobs\".\"payload\"::text) <= 1024"
        },
        "platform_jobs_attempts_check": {
          "name": "platform_jobs_attempts_check",
          "value": "\"platform_jobs\".\"attempts\" >= 0 AND \"platform_jobs\".\"max_attempts\" BETWEEN 1 AND 25 AND \"platform_jobs\".\"attempts\" <= \"platform_jobs\".\"max_attempts\""
        },
        "platform_jobs_lease_check": {
          "name": "platform_jobs_lease_check",
          "value": "(\"platform_jobs\".\"status\" = 'RUNNING') = (\"platform_jobs\".\"lease_id\" IS NOT NULL AND \"platform_jobs\".\"lease_owner\" IS NOT NULL AND \"platform_jobs\".\"lease_expires_at\" IS NOT NULL)\n          AND (\"platform_jobs\".\"lease_id\" IS NULL) = (\"platform_jobs\".\"lease_owner\" IS NULL) AND (\"platform_jobs\".\"lease_id\" IS NULL) = (\"platform_jobs\".\"lease_expires_at\" IS NULL)"
        },
        "platform_jobs_finished_check": {
          "name": "platform_jobs_finished_check",
          "value": "(\"platform_jobs\".\"status\" IN ('SUCCEEDED','DEAD')) = (\"platform_jobs\".\"finished_at\" IS NOT NULL)"
        },
        "platform_jobs_failure_class_check": {
          "name": "platform_jobs_failure_class_check",
          "value": "\"platform_jobs\".\"last_failure_class\" IS NULL OR \"platform_jobs\".\"last_failure_class\" ~ '^[a-z][a-z0-9_]{0,62}$'"
        }
