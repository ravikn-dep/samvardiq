        "identity_audit_events_actor_principal_type_check": {
          "name": "identity_audit_events_actor_principal_type_check",
          "value": "\"identity_audit_events\".\"actor_principal_type\" IN ('human','service','system')"
        },
        "identity_audit_events_actor_consistency_check": {
          "name": "identity_audit_events_actor_consistency_check",
          "value": "(\"identity_audit_events\".\"actor_principal_type\" = 'system' AND \"identity_audit_events\".\"actor_identity_id\" IS NULL) OR (\"identity_audit_events\".\"actor_principal_type\" IN ('human','service') AND \"identity_audit_events\".\"actor_identity_id\" IS NOT NULL)"
        },
        "identity_audit_events_event_type_check": {
          "name": "identity_audit_events_event_type_check",
          "value": "\"identity_audit_events\".\"event_type\" IN ('IDENTITY_CREATED','IDENTITY_STATUS_CHANGED','PROVIDER_LINK_CREATED','PROVIDER_LINK_REMOVED','MEMBERSHIP_CREATED','MEMBERSHIP_STATUS_CHANGED','MEMBERSHIP_ROLE_CHANGED','AUTHENTICATION_FAILED','AUTHORIZATION_FAILED')"
        },
        "identity_audit_events_organization_scope_check": {
          "name": "identity_audit_events_organization_scope_check",
          "value": "(\"identity_audit_events\".\"event_type\" IN ('MEMBERSHIP_CREATED','MEMBERSHIP_STATUS_CHANGED','MEMBERSHIP_ROLE_CHANGED') AND \"identity_audit_events\".\"organization_id\" IS NOT NULL) OR (\"identity_audit_events\".\"event_type\" IN ('IDENTITY_CREATED','IDENTITY_STATUS_CHANGED','PROVIDER_LINK_CREATED','PROVIDER_LINK_REMOVED') AND \"identity_audit_events\".\"organization_id\" IS NULL) OR \"identity_audit_events\".\"event_type\" IN ('AUTHENTICATION_FAILED','AUTHORIZATION_FAILED')"
        },
        "identity_audit_events_target_type_check": {
          "name": "identity_audit_events_target_type_check",
          "value": "\"identity_audit_events\".\"target_type\" IN ('IDENTITY','MEMBERSHIP','PROVIDER_LINK')"
        },
        "identity_audit_events_outcome_check": {
          "name": "identity_audit_events_outcome_check",
          "value": "\"identity_audit_events\".\"outcome\" IN ('SUCCESS','DENIED','FAILED')"
        },
        "identity_audit_events_reason_length_check": {
          "name": "identity_audit_events_reason_length_check",
          "value": "\"identity_audit_events\".\"reason\" IS NULL OR char_length(\"identity_audit_events\".\"reason\") <= 500"
        }
      },
      "isRLSEnabled": false
    },
