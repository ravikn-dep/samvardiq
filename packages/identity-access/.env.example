# Copy to .env for local development. Never commit .env itself (already gitignored).
# For IDENTITY-W2/W3 tests, no .env is needed at all — the test harnesses
# start and configure their own disposable infrastructure (embedded
# PostgreSQL, a local JWKS server for token-verification tests).
DATABASE_URL=postgres://samvardiq_app:CHANGE_ME@localhost:5432/samvardiq

# IDENTITY-W3: Supabase project URL only — NOT a secret (the JWKS endpoint
# it points at is public by design; no service-role or anon key is read
# by this package at all — see providers/supabaseIdentityProviderAdapter.ts).
SUPABASE_PROJECT_URL=https://your-project-ref.supabase.co
